# Server
PORT=8080
NODE_ENV=development

# ─── Produção (planejapost.com) ─────────────────────────────────────────────
# Frontend: https://app.planejapost.com
# API:      https://api.planejapost.com
# CORS_ORIGIN=https://app.planejapost.com
# BETTER_AUTH_URL=https://api.planejapost.com
# PUBLIC_API_URL=https://api.planejapost.com
# SMTP_FROM=noreply@planejapost.com
# Webhook Oasyfy: https://api.planejapost.com/api/v1/webhooks/oasyfy
# Webhook Stripe: https://api.planejapost.com/api/v1/webhooks/stripe
# Webhook Zernio: https://api.planejapost.com/api/v1/webhooks/zernio

# Database (docker-compose: planejapost-postgres na porta 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/planejapost?schema=public

# Better Auth
# Gere um secret com: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-use-openssl-rand-base64-32-min-32-chars
BETTER_AUTH_URL=http://localhost:8080

# CORS (origem do frontend)
CORS_ORIGIN=http://localhost:5173

# Zernio API
ZERNIO_API_KEY=sk_change_me
# Mesmo secret usado ao registrar POST /v1/webhooks/settings na Zernio
ZERNIO_WEBHOOK_SECRET=change-me-use-openssl-rand-hex-32
# Base URL do SDK @zernio/node (sem /v1 — o SDK já inclui nos paths)
# ZERNIO_API_BASE_URL=https://zernio.com/api
# Validação E2E: bun run validate:zernio

# URL pública da API
PUBLIC_API_URL=http://localhost:8080

# ngrok (desenvolvimento — webhooks externos)
# USE_NGROK=true expõe a API via ngrok e sobrescreve PUBLIC_API_URL com a URL pública
# USE_NGROK=false ou omitido: ngrok desligado
# USE_NGROK=true
# NGROK_AUTHTOKEN=your_ngrok_authtoken

# Redis (opcional — reservado para filas futuras)
# docker-compose: planejapost-redis na porta 6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Oasyfy (PIX)
OASYFY_PUBLIC_KEY=
OASYFY_SECRET_KEY=
# OASYFY_API_BASE_URL=https://app.oasyfy.com/api/v1
# Webhook / callbackUrl: {PUBLIC_API_URL}/api/v1/webhooks/oasyfy
# Smoke test PIX (admin): /admin/billing/settings — valor mínimo R$ 1,00
# CLI: bun run scripts/validate-oasyfy-credentials.ts

# Stripe (cartão)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# SMTP
SMTP_HOST=smtp.smtp.com
SMTP_PORT=465
SMTP_USERNAME=email@email.com
SMTP_PASSWORD="smtp_password"
SMTP_FROM=email@email.com
SMTP_SECURE=true # true para SSL/TLS, false para STARTTLS
