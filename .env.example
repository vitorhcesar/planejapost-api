# Server
PORT=8080
NODE_ENV=development

# ─── Produção (planejapost.com.br) ─────────────────────────────────────────────
# Frontend: https://app.planejapost.com.br
# API:      https://api.planejapost.com.br
# CORS_ORIGIN=https://app.planejapost.com.br
# BETTER_AUTH_URL=https://api.planejapost.com.br
# PUBLIC_API_URL=https://api.planejapost.com.br
# SMTP_FROM=noreply@planejapost.com.br
# Webhook OmegaPay: https://api.planejapost.com.br/api/v1/webhooks/omegapay
# Webhook Zernio: https://api.planejapost.com.br/api/v1/webhooks/zernio

# Database (docker-compose: planejapost-postgres na porta 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/planejapost?schema=public

# Better Auth
# Gere um secret com: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-use-openssl-rand-base64-32-min-32-chars
BETTER_AUTH_URL=http://localhost:8080

# CORS (origem do frontend)
CORS_ORIGIN=http://localhost:5173

# Zernio API
ZERNIO_API_KEY=sk_change_me
# Mesmo secret usado ao registrar POST /v1/webhooks/settings na Zernio
ZERNIO_WEBHOOK_SECRET=change-me-use-openssl-rand-hex-32
# ZERNIO_API_BASE_URL=https://zernio.com/api/v1
# Validação E2E: bun run validate:zernio

# URL pública da API
PUBLIC_API_URL=http://localhost:8080

# ngrok (desenvolvimento — webhooks externos)
# USE_NGROK=true expõe a API via ngrok e sobrescreve PUBLIC_API_URL com a URL pública
# USE_NGROK=false ou omitido: ngrok desligado
# USE_NGROK=true
# NGROK_AUTHTOKEN=your_ngrok_authtoken

# MinIO (object storage temporário de mídias)
# docker-compose: planejapost-minio nas portas 9000 (API) e 9001 (console)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=planejapost-temp
MINIO_USE_SSL=false

# Redis (opcional — reservado para filas futuras)
# docker-compose: planejapost-redis na porta 6379
REDIS_HOST=localhost
REDIS_PORT=6379

# OmegaPay
# Credenciais em: painel OmegaPay > Integrações > API
OMEGAPAY_PUBLIC_KEY=
OMEGAPAY_SECRET_KEY=
# URL de webhook para callbackUrl / painel: {PUBLIC_API_URL}/api/v1/webhooks/omegapay

# SMTP
SMTP_HOST=smtp.smtp.com
SMTP_PORT=465
SMTP_USERNAME=email@email.com
SMTP_PASSWORD="smtp_password"
SMTP_FROM=email@email.com
SMTP_SECURE=true # true para SSL/TLS, false para STARTTLS
