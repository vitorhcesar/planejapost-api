generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id
  name                     String
  email                    String
  emailVerified            Boolean                   @default(false)
  image                    String?
  role                     String                    @default("client")
  zernioProfileId          String?                   @unique
  defaultTimezone          String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  sessions                 Session[]
  accounts                 Account[]
  socialConnectedAccounts  SocialConnectedAccount[]
  accountSlots             AccountSlot[]
  publications             Publication[]
  socialConnectSessions    SocialConnectSession[]
  wallet                   Wallet?
  publicationQueue         UserZernioQueue?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model SocialConnectedAccount {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform          String
  zernioAccountId   String
  zernioProfileId   String
  username          String
  displayName       String?
  avatarUrl         String?
  status            String              @default("connected")
  canPost           Boolean             @default(true)
  needsReconnect    Boolean             @default(false)
  permissions       Json?
  connectedAt       DateTime            @default(now())
  disconnectedAt    DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  publicationTargets PublicationTarget[]
  accountSlot       AccountSlot?

  @@unique([userId, zernioAccountId])
  @@index([userId])
  @@index([userId, platform, status])
  @@index([zernioAccountId])
  @@map("social_connected_account")
}

model SocialConnectSession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountSlotId   String
  platform        String
  zernioProfileId String
  mode            String   @default("standard")
  state           String   @unique
  tempToken       String?
  connectToken    String?
  step            String?
  expiresAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("social_connect_session")
}

model AccountSlot {
  id                        String                  @id @default(cuid())
  userId                    String
  user                      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialConnectedAccountId  String?                 @unique
  socialConnectedAccount    SocialConnectedAccount? @relation(fields: [socialConnectedAccountId], references: [id], onDelete: SetNull)
  status                    String                  @default("active")
  expiresAt                 DateTime
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("account_slot")
}

model Publication {
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String
  destinationScope String
  caption          String?
  mediaUrl         String
  objectKey        String?
  objectKeys       String[]            @default([])
  zernioPostId     String?             @unique
  idempotencyKey   String              @unique
  status           String              @default("pending")
  scheduledFor     DateTime?
  timezone         String?
  publishMode      String              @default("now")
  zernioQueueId    String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  targets          PublicationTarget[]

  @@index([userId])
  @@index([status])
  @@index([zernioPostId])
  @@index([scheduledFor])
  @@map("publication")
}

model PublicationTarget {
  id                       String                 @id @default(cuid())
  publicationId            String
  publication              Publication            @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  socialConnectedAccountId String
  socialConnectedAccount   SocialConnectedAccount @relation(fields: [socialConnectedAccountId], references: [id], onDelete: Cascade)
  platform                 String
  zernioAccountId          String
  status                   String                 @default("pending")
  platformPostId           String?
  platformPostUrl          String?
  errorMessage             String?
  errorCode                String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([publicationId])
  @@index([socialConnectedAccountId])
  @@index([status])
  @@map("publication_target")
}

model UserZernioQueue {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  zernioProfileId String
  zernioQueueId   String
  name            String   @default("Default")
  timezone        String
  slots           Json
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([zernioQueueId])
  @@map("user_zernio_queue")
}

model ZernioWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([eventType])
  @@index([createdAt])
  @@map("zernio_webhook_event")
}

model OmegaPayWebhookEvent {
  id         String   @id @default(cuid())
  event      String
  token      String
  payload    Json
  receivedAt DateTime @default(now())

  @@index([event])
  @@index([receivedAt])
  @@map("omegapay_webhook_event")
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Decimal             @default(0) @db.Decimal(12, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]
  recharges    WalletRecharge[]

  @@map("wallet")
}

model WalletTransaction {
  id           String   @id @default(cuid())
  walletId     String
  wallet       Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type         String
  amount       Decimal  @db.Decimal(12, 2)
  balanceAfter Decimal  @db.Decimal(12, 2)
  description  String?
  referenceKey String?  @unique
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([walletId])
  @@index([createdAt])
  @@map("wallet_transaction")
}

model WalletRecharge {
  id                    String    @id @default(cuid())
  walletId              String
  wallet                Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  identifier            String    @unique
  amount                Decimal   @db.Decimal(12, 2)
  status                String    @default("pending")
  omegapayTransactionId String?
  pixCode               String?
  pixImageUrl           String?
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([walletId])
  @@index([status])
  @@index([omegapayTransactionId])
  @@map("wallet_recharge")
}
