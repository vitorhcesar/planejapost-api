generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id
  name                     String
  email                    String
  emailVerified            Boolean                   @default(false)
  image                    String?
  role                     String                    @default("client")
  zernioProfileId          String?                   @unique
  defaultTimezone          String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  sessions                 Session[]
  accounts                 Account[]
  workspaces               Workspace[]
  socialConnectedAccounts  SocialConnectedAccount[]
  publications             Publication[]
  socialConnectSessions    SocialConnectSession[]
  publicationQueue         UserZernioQueue?
  subscription             Subscription?

  @@unique([email])
  @@map("user")
}

model Workspace {
  id                      String                   @id @default(cuid())
  userId                  String
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                    String
  slug                    String
  description             String?
  color                   String?
  isDefault               Boolean                  @default(false)
  archivedAt              DateTime?
  sortOrder               Int                      @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  socialConnectedAccounts SocialConnectedAccount[]
  socialConnectSessions   SocialConnectSession[]
  publications            Publication[]

  @@unique([userId, slug])
  @@index([userId, archivedAt])
  @@index([userId, isDefault])
  @@map("workspace")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model SocialConnectedAccount {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId       String
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  platform          String
  zernioAccountId   String
  zernioProfileId   String
  username          String
  displayName       String?
  avatarUrl         String?
  status            String              @default("connected")
  canPost           Boolean             @default(true)
  needsReconnect    Boolean             @default(false)
  permissions       Json?
  connectedAt       DateTime            @default(now())
  disconnectedAt    DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  publicationTargets PublicationTarget[]

  @@unique([userId, zernioAccountId])
  @@index([userId])
  @@index([userId, platform, status])
  @@index([workspaceId, status])
  @@index([zernioAccountId])
  @@map("social_connected_account")
}

model SocialConnectSession {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId              String
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  reconnectSocialAccountId String?
  socialConnectedAccountId String?
  platform                 String
  zernioProfileId String
  mode            String   @default("standard")
  state           String   @unique
  tempToken       String?
  connectToken    String?
  step            String?
  expiresAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("social_connect_session")
}

model Publication {
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId      String?
  workspace        Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  type             String
  destinationScope String
  caption          String?
  mediaUrl         String
  objectKey        String?
  objectKeys       String[]            @default([])
  zernioPostId     String?             @unique
  idempotencyKey   String              @unique
  status           String              @default("pending")
  scheduledFor     DateTime?
  timezone         String?
  publishMode      String              @default("now")
  zernioQueueId    String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  targets          PublicationTarget[]

  @@index([userId])
  @@index([userId, workspaceId, createdAt])
  @@index([status])
  @@index([zernioPostId])
  @@index([scheduledFor])
  @@map("publication")
}

model PublicationTarget {
  id                       String                 @id @default(cuid())
  publicationId            String
  publication              Publication            @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  socialConnectedAccountId String
  socialConnectedAccount   SocialConnectedAccount @relation(fields: [socialConnectedAccountId], references: [id], onDelete: Cascade)
  platform                 String
  zernioAccountId          String
  status                   String                 @default("pending")
  platformPostId           String?
  platformPostUrl          String?
  errorMessage             String?
  errorCode                String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([publicationId])
  @@index([socialConnectedAccountId])
  @@index([status])
  @@map("publication_target")
}

model UserZernioQueue {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  zernioProfileId String
  zernioQueueId   String
  name            String   @default("Default")
  timezone        String
  slots           Json
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([zernioQueueId])
  @@map("user_zernio_queue")
}

model ZernioWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([eventType])
  @@index([createdAt])
  @@map("zernio_webhook_event")
}

model BillingSettings {
  id                        String   @id @default("default")
  pixPaymentsEnabled        Boolean  @default(true)
  cardPaymentsEnabled       Boolean  @default(false)
  gracePeriodDays           Int      @default(3)
  renewalReminderDays       Int[]    @default([7, 3])
  invoiceGenerationLeadDays Int      @default(7)
  updatedAt                 DateTime @updatedAt

  @@map("billing_settings")
}

model SubscriptionPlan {
  id                 String         @id
  name               String
  priceMonthlyBrl    Decimal        @db.Decimal(12, 2)
  connectionsLimit   Int
  postsPerMonthLimit Int
  features           Json
  stripePriceId      String?
  sortOrder          Int
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  subscriptions      Subscription[]

  @@map("subscription_plan")
}

model Subscription {
  id                     String                    @id @default(cuid())
  userId                 String                    @unique
  user                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   SubscriptionPlan          @relation(fields: [planId], references: [id])
  status                 String
  preferredPaymentMethod String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  dueAt                  DateTime?
  gracePeriodEndsAt      DateTime?
  cancelAtPeriodEnd      Boolean                   @default(false)
  scheduledPlanId        String?
  stripeCustomerId       String?
  trialEndsAt            DateTime?
  trialGrantedAt         DateTime?
  trialGrantedByUserId   String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  invoices               SubscriptionInvoice[]
  usageRecords           SubscriptionUsageRecord[]
  reminderLogs           SubscriptionReminderLog[]

  @@index([status])
  @@index([dueAt])
  @@index([gracePeriodEndsAt])
  @@map("subscription")
}

model SubscriptionInvoice {
  id                      String       @id @default(cuid())
  subscriptionId          String
  subscription            Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  type                    String
  status                  String
  amount                  Decimal      @db.Decimal(12, 2)
  currency                String       @default("BRL")
  paymentMethod           String?
  dueAt                   DateTime
  paidAt                  DateTime?
  periodStart             DateTime?
  periodEnd               DateTime?
  oasyfyTransactionId     String?
  pixCode                 String?
  pixImageUrl             String?
  pixExpiresAt            DateTime?
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  manualPaidReason        String?
  manualPaidByUserId      String?
  manualPaidAt            DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@index([subscriptionId])
  @@index([status])
  @@index([dueAt])
  @@index([oasyfyTransactionId])
  @@index([stripeCheckoutSessionId])
  @@map("subscription_invoice")
}

model SubscriptionUsageRecord {
  id              String       @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  periodStart     DateTime
  periodEnd       DateTime
  postsUsed       Int          @default(0)
  connectionsUsed Int          @default(0)
  updatedAt       DateTime     @updatedAt

  @@unique([subscriptionId, periodStart])
  @@map("subscription_usage_record")
}

model SubscriptionReminderLog {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoiceId      String?
  daysBeforeDue  Int
  sentAt         DateTime     @default(now())

  @@unique([subscriptionId, invoiceId, daysBeforeDue])
  @@map("subscription_reminder_log")
}

model OasyfyWebhookEvent {
  id         String   @id @default(cuid())
  event      String
  token      String
  payload    Json
  receivedAt DateTime @default(now())

  @@index([event])
  @@index([receivedAt])
  @@map("oasyfy_webhook_event")
}

model OasyfyPixTestPayment {
  id                  String    @id @default(cuid())
  createdByUserId     String
  amount              Decimal   @db.Decimal(12, 2)
  status              String
  oasyfyTransactionId String?
  pixCode             String?
  pixImageUrl         String?
  pixExpiresAt        DateTime?
  paidAt              DateTime?
  webhookEventId      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([createdByUserId])
  @@index([status])
  @@index([oasyfyTransactionId])
  @@map("oasyfy_pix_test_payment")
}

model StripeWebhookEvent {
  id         String   @id @default(cuid())
  eventId    String   @unique
  eventType  String
  payload    Json
  receivedAt DateTime @default(now())

  @@index([eventType])
  @@map("stripe_webhook_event")
}
